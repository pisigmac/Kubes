# Copy to the repository root as .env.provider-credentials and replace every placeholder.
PROVIDER_CREDENTIALS_DB_PASSWORD=replace-with-a-random-local-password
SERVICE_CLIENT_TOKEN=replace-with-a-random-independent-client-token
CREDENTIALS_MASTER_KEY=replace-with-base64-encoded-32-random-bytes
IDENTITY_JWKS_URL=https://identity.example/.well-known/jwks.json
IDENTITY_ISSUER=https://identity.example/
IDENTITY_AUDIENCE=kubes
IDENTITY_SUBJECT_CLAIM=sub
IDENTITY_TENANT_CLAIM=org_id
ALLOW_HTTP_PROVIDER_URLS=false
