# OpenAI-compatible chat endpoint. SpaceXAI (xAI) is the default.
# OpenRouter, Groq, and vLLM work the same way: change the base URL and model id.
# This app calls /chat/completions (not the Responses API) so third-party servers work.
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
# Also accepted if OPENAI_API_KEY is unset: XAI_API_KEY
OPENAI_MODEL=grok-4.7
# GET /models on this base URL fills the model dropdown.

# OpenRouter example (model ids include the vendor):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=x-ai/grok-4.7
