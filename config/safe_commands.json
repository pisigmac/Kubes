{
  "safePrefixes": [
    "pwd",
    "ls",
    "cat",
    "echo",
    "head",
    "tail",
    "wc",
    "git status",
    "git log",
    "git branch",
    "git diff",
    "which",
    "date",
    "whoami",
    "tree",
    "file"
  ],
  "disallowedTokens": [
    ";",
    "&&",
    "||",
    "|",
    ">",
    ">>",
    "<",
    "`",
    "$(",
    "${",
    "rm",
    "mv",
    "cp",
    "chmod",
    "chown",
    "curl",
    "wget",
    "ssh",
    "nc",
    "kill",
    "pkill",
    "reboot",
    "shutdown",
    "sudo",
    "su"
  ]
}
